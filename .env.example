# Copiar como .env (o exportar como variables de entorno reales) y completar.
# Nunca commitear el archivo .env real.

SIGAI_PROFILE=dev

# --- Base de datos: OPCION A (default) - host:puerto + usuario/password SQL ---
DB_HOST=localhost
DB_PORT=1433
DB_NAME=sigai_ws
DB_USER=sa
DB_PASSWORD=ChangeMe_123!
DB_ENCRYPT=true
DB_TRUST_CERT=true

# --- Base de datos: OPCION B - SQLEXPRESS local con TCP/IP en puerto fijo +
# autenticacion de Windows integrada (ver docs/DEV_GUIDE.md "Autenticacion de
# Windows con SQL Server"). Si se define DB_URL, tiene prioridad sobre
# DB_HOST/DB_PORT/DB_USER/DB_PASSWORD de arriba (dejar esas sin usar).
# Puerto fijo 14330 configurado a mano en SQL Server Configuration Manager
# (Protocols for SQLEXPRESS > TCP/IP > IPAll > TCP Port), para no depender del
# servicio SQL Server Browser (detenido por defecto).
# encrypt=false porque versiones viejas de SQL Server (ej. 2008 R2) solo soportan
# TLS 1.0, rechazado por el driver moderno + JDK 21. En un servidor real/productivo
# con una version de SQL Server actual, usar encrypt=true;trustServerCertificate=true (o false + certificado real).
DB_URL=jdbc:sqlserver://localhost:14330;databaseName=SIGAI_WS;integratedSecurity=true;encrypt=false
# Ademas, contra SQL Server <=2008 R2 (sin INFORMATION_SCHEMA.SEQUENCES), agregar:
# JPA_DDL_AUTO=none

# Servidor
SERVER_PORT=8443
COOKIE_SECURE=false

# SMTP (en dev, apuntar a mailhog levantado por docker-compose, o dejar vacio:
# EmailService loguea el error y no interrumpe el flujo si el envio falla)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
# Direccion "From:" de los emails salientes (independiente de SMTP_USER, que
# autentica contra el servidor SMTP y puede quedar vacio en SMTP sin auth).
SIGAI_EMAIL_REMITENTE=no-reply@wellspringschool.edu.ar

# Almacenamiento de documentos/fotos de legajos
STORAGE_PATH=./storage

# Clave AES-256 para cifrado de columnas sensibles (DNI, datos medicos, etc.)
# Generar con: openssl rand -base64 32 (o el equivalente en PowerShell, ver DEV_GUIDE.md)
SIGAI_AES_KEY=

THYMELEAF_CACHE=false

# Solo se usan si todavia no existe ningun usuario Superadministrador (primer arranque).
SIGAI_BOOTSTRAP_ADMIN_EMAIL=admin@wellspringschool.edu.ar
SIGAI_BOOTSTRAP_ADMIN_PASSWORD=CambiarInmediatamente#123
